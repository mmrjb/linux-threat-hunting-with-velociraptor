-- LTH 06: Persistence Mechanisms
-- Execute in an authorized SERVER notebook after importing artifacts.
-- Set an existing label assigned only to the intended Linux clients.
-- Unchanged label placeholder produces no hunt. All created hunts are paused.
-- Recorded resource limits are historical caps; review upload sources and limits.
LET TargetLabel <= "SET_TARGET_LABEL"
LET HuntDurationSeconds <= 86400

SELECT hunt(
        description="LTH - 06 - Persistence Mechanisms",
        artifacts=["LTH.Persistence"],
        include_labels=[TargetLabel],
        pause=TRUE,
        expires=now() + HuntDurationSeconds,
        timeout=3600,
        max_bytes=1073741824
    ) AS Hunt
FROM if(
    condition=TargetLabel != "SET_TARGET_LABEL"
        AND TargetLabel != "" AND HuntDurationSeconds > 0,
    then={ SELECT * FROM scope() },
    else={
        SELECT * FROM scope()
        WHERE log(message="Set TargetLabel and a positive HuntDurationSeconds before creating a hunt")
          AND FALSE
    }
)
